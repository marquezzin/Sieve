# ─── Django ──────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-in-production-this-is-not-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ─── Host port mappings ──────────────────────────────────────────────────────
# Só afetam o lado do HOST (porta interna do container não muda). Override quando
# rodar outro stack local na mesma porta. Ao mudar FRONTEND_HOST_PORT, adicione a
# origem correspondente em CORS_ALLOWED_ORIGINS.
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
FRONTEND_HOST_PORT=5173

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_DB=sieve
POSTGRES_USER=sieve
POSTGRES_PASSWORD=sieve
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ─── Redis / Celery ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── MinIO (S3-compatible) ───────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=sieve-artifacts

# ─── CORS ────────────────────────────────────────────────────────────────────
# Lista CSV de origens permitidas. Case-sensitive, sem trailing slash, com schema.
# Em prod: liberar SÓ o domínio real do frontend. Nunca CORS_ALLOW_ALL_ORIGINS=True.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# ─── Observabilidade ─────────────────────────────────────────────────────────
# Sentry é opt-in: DSN vazio = desligado. Populado = liga (Django + Celery).
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# Logging: pretty (texto colorido) em dev; json (uma linha por evento) em prod.
LOG_LEVEL=INFO
LOG_MODE=pretty

# ─── LLM (agentes: entrevistador, redator, revisor, juiz, ATS) ───────────────
# Provider do tool-use/chat. `openai` é o DEFAULT proposital do projeto
# (gpt-4o-mini, barato p/ conversa multi-turn); `anthropic` é opt-in. O cliente
# do provider não escolhido é ignorado — preencha só a chave do que você usa.
LLM_PROVIDER=openai
# OpenAI (Chat Completions). Modelo barato p/ conversa multi-turn.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Anthropic (opcional). SDK opt-in: `uv add anthropic` se for usar.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Pipeline de currículo (Fase 2) — writer/reviewer/judge usam o MESMO provider/modelo
# do entrevistador (OpenAI por default). Deixe vazio pra herdar OPENAI_MODEL; preencha
# só pra subir um agente a um modelo mais forte sem mexer nos outros.
LLM_MODEL_WRITER=
LLM_MODEL_REVIEWER=
LLM_MODEL_JUDGE=
# Matching (Fase 3) — extrator de keywords da vaga (tarefa simples; Haiku serve).
# Vazio = herda o modelo default do provider.
LLM_MODEL_KEYWORD_EXTRACTOR=
# Otimizador ATS reescreve o currículo pra vaga (precisão > custo). Vazio = default.
LLM_MODEL_ATS_OPTIMIZER=
# Keyword da vaga com similaridade coseno < threshold ao currículo conta como
# "ausente" no sinal de sanidade do match. Ajustar empiricamente após smoke real.
ATS_GAP_THRESHOLD=0.5

# ─── Embeddings (knowledge base / matching semântico) ───────────────────────
# Provider de embeddings usado pela knowledge base + matching de currículos.
# Default `voyage` (voyage-3, 1024 dims). Trocar provider/modelo invalida os
# vetores já indexados — rodar `make ingest-knowledge-force` depois.
EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=voyage-3
EMBEDDINGS_DIM=1024

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# Default '/api' (proxy via vite). Override só em prod.
VITE_API_BASE_URL=

# Target do proxy `/api` no dev server. Default `http://backend:8000` casa com
# Vite rodando dentro do container compose. Quando rodar Vite no host (via
# `make dev` em Colima/macOS), defina num `.env.local` do frontend:
#   VITE_PROXY_TARGET=http://localhost:8000
VITE_PROXY_TARGET=
